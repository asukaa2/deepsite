{
  "name": "deepsite",
  "version": "1.0.0",
  "description": "AI-powered web app generator with multi-provider LLM support, MCP integration, claude-code-style skills, mobile/Android templates, and full-stack multi-file project mode. Vite + React + Express — no Next.js, no SDK lock-in.",
  "type": "module",
  "license": "MIT",
  "author": "asukaa2",
  "homepage": "https://github.com/asukaa2/deepsite",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asukaa2/deepsite.git"
  },
  "bugs": {
    "url": "https://github.com/asukaa2/deepsite/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "code-generator",
    "html-generator",
    "openai",
    "claude",
    "gemini",
    "deepseek",
    "mcp",
    "vite",
    "react",
    "express",
    "tailwindcss",
    "material-design",
    "react-native-web"
  ],
  "bin": {
    "deepsite": "bin/deepsite.js"
  },
  "files": [
    "bin/",
    "public/",
    "src/",
    "utils/",
    "middlewares/",
    "server.js",
    "vite.config.ts",
    "tsconfig.json",
    "tsconfig.app.json",
    "tsconfig.node.json",
    "eslint.config.js",
    "module.d.ts",
    ".env.example",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node server.js",
    "start:dev": "concurrently \"npm run dev\" \"npm run start\"",
    "vercel-build": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@huggingface/hub": "^1.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.0.15",
    "body-parser": "^1.20.3",
    "classnames": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^15.4.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-speech-recognition": "^4.0.0",
    "react-toastify": "^11.0.5",
    "react-use": "^17.6.0",
    "tailwindcss": "^4.0.15",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/express": "^5.0.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-speech-recognition": "^3.9.6",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-plugin-monaco-editor": "^1.1.0"
  }
}
