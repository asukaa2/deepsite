# Server port
APP_PORT=3000

# --- Default provider (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Multi-provider env vars (all optional; UI can also configure per-provider) ---
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# Mistral
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-large-latest

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Fireworks
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct

# Together
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Novita
NOVITA_API_KEY=
NOVITA_BASE_URL=https://api.novita.ai/v3/openai
NOVITA_MODEL=deepseek/deepseek-v3-0324

# SambaNova
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# Hyperbolic
HYPERBOLIC_API_KEY=
HYPERBOLIC_BASE_URL=https://api.hyperbolic.xyz/v1
HYPERBOLIC_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Nebius
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Ollama (local) — no key required
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Custom (OpenAI-compatible) endpoint
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# --- MCP servers (JSON array, registered on startup) ---
# Example:
# MCP_CONFIG={"filesystem":{"type":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]}}
MCP_CONFIG=

# --- Custom Skills (JSON array, registered on startup) ---
# Example:
# SKILLS_CONFIG=[{"id":"my-skill","name":"My Skill","description":"...","prompt":"..."}]
SKILLS_CONFIG=

# --- Gradio Server (Gradio 6+) ---
# The Gradio sidebar panel spawns Python subprocesses running gradio.Server.
# Override the Python interpreter used (defaults to python3).
PYTHON_BIN=python3
# Or set GRADIO_PYTHON to override just for Gradio launches.
# GRADIO_PYTHON=/path/to/venv/bin/python
# Default share/MCP toggles (the panel can also toggle per-launch)
GRADIO_SHARE=True
GRADIO_MCP_SERVER=True

# --- Generation defaults ---
DEFAULT_MAX_TOKENS=64000
DEFAULT_TEMPERATURE=0

# --- IP rate limiting (0 or unset = unlimited) ---
IP_RATE_LIMIT=0
